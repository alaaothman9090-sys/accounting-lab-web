  "misconceptions": [
    { "tag": "debit-means-good", "labelAr": "المدين يعني حاجة كويسة", "explanationAr": "المدين والدائن مجرد جانبين في القيد. المدين بيزوّد الأصول والمصروفات ويقلل الالتزامات وحقوق الملكية والإيرادات — مالوش علاقة بالخير والشر.", "remediationLessonId": "L03" },
    { "tag": "credit-means-loan", "labelAr": "الدائن يعني قرض أو دين", "explanationAr": "الدائن جانب في القيد بيزوّد الالتزامات وحقوق الملكية والإيرادات ويقلل الأصول. رأس المال دائن مع إنه مش قرض.", "remediationLessonId": "L03" },
    { "tag": "cash-received-equals-revenue", "labelAr": "أي فلوس داخلة = إيراد", "explanationAr": "الإيراد بيتكسب لما الشركة تنفّذ (تسلّم). فلوس المالك أو التحصيل من عميل أو الدفعة المقدمة مش إيراد.", "remediationLessonId": "L02" },
    { "tag": "prepaid-is-expense", "labelAr": "المدفوع مقدمًا مصروف على طول", "explanationAr": "الدفع المقدم بيشتري حق استخدام في المستقبل = أصل. بيتحول لمصروف مع الاستهلاك.", "remediationLessonId": "L01" },
    { "tag": "balanced-means-correct", "labelAr": "القيد المتوازن يبقى صح", "explanationAr": "التوازن بيثبت إن المدين = الدائن بس. ممكن الحساب أو التوقيت أو المبلغ يبقى غلط والقيد متوازن.", "remediationLessonId": "L11" },
    { "tag": "bank-credit-means-decrease", "labelAr": "الدائن في كشف البنك يعني نقص في رصيدي", "explanationAr": "كشف البنك مكتوب من وجهة نظر البنك: رصيدك عنده التزام عليه، فالدائن في كشفك بيزوّد رصيدك.", "remediationLessonId": "L08" },
    { "tag": "drawings-are-expense", "labelAr": "مسحوبات المالك مصروف", "explanationAr": "المسحوبات بتقلل حقوق الملكية مباشرة ومش بتدخل قائمة الدخل.", "remediationLessonId": "L16" },
    { "tag": "depreciation-is-cash", "labelAr": "الإهلاك فلوس بتطلع", "explanationAr": "الإهلاك توزيع لتكلفة أصل اتدفع قبل كده؛ مفيش نقدية بتتحرك وقت قيده.", "remediationLessonId": "L22" },
    { "tag": "advance-is-revenue", "labelAr": "الدفعة المقدمة من العميل إيراد", "explanationAr": "الدفعة المقدمة التزام بالتسليم لحد ما الشركة تسلّم.", "remediationLessonId": "L15" },
    { "tag": "profit-equals-cash", "labelAr": "الربح = النقدية", "explanationAr": "الربح بيقيس الكسب على أساس الاستحقاق؛ النقدية بتقيس حركة الفلوس. ممكن شركة تكسب وفلوسها تقل.", "remediationLessonId": "L10" },
    { "tag": "inventory-purchase-is-expense", "labelAr": "شراء البضاعة مصروف", "explanationAr": "في الجرد المستمر الشراء بيزوّد المخزون (أصل)، والتكلفة بتظهر وقت البيع.", "remediationLessonId": "L04" },
    { "tag": "return-increases-sales", "labelAr": "المرتجع بيزوّد المبيعات", "explanationAr": "مردودات المبيعات بتقلل صافي المبيعات (حساب عكسي مدين).", "remediationLessonId": "L06" },
    { "tag": "timing-item-needs-book-entry", "labelAr": "بند التوقيت محتاج قيد", "explanationAr": "الإيداع في الطريق والشيك المعلّق هيظهروا في كشف البنك الجاي لوحدهم؛ ما ينفعش يتقيدوا في الدفاتر.", "remediationLessonId": "L08" },
    { "tag": "missing-invoice-means-no-liability", "labelAr": "مفيش فاتورة يبقى مفيش التزام", "explanationAr": "الالتزام بيتولد من الاستهلاك أو الاستلام؛ ممكن نسجل مصروف مستحق بتقدير معتمد قبل الفاتورة.", "remediationLessonId": "L15" },
    { "tag": "closing-deletes-history", "labelAr": "الإقفال بيمسح التاريخ", "explanationAr": "قيود الإقفال بتنقل الأرصدة لرأس المال؛ القيود الأصلية فاضلة والتقارير بتعرض نشاط الفترة.", "remediationLessonId": "L24" },
    { "tag": "duplicate-invoice-posted", "labelAr": "تسجيل فاتورة مكررة", "explanationAr": "نفس رقم الفاتورة ونفس المبلغ والتاريخ = غالبًا نسخة مكررة. افحص قبل التسجيل.", "remediationLessonId": "L13" },
    { "tag": "drcr-direction", "labelAr": "خلط في اتجاه المدين والدائن", "explanationAr": "ارجع للمعادلة: الأصول والمصروفات والمسحوبات بتزيد مدين؛ الالتزامات وحقوق الملكية والإيرادات بتزيد دائن.", "remediationLessonId": "L03" },
    { "tag": "wrong-account", "labelAr": "اختيار حساب غير مناسب", "explanationAr": "اسأل: إيه المورد أو الحق أو الالتزام اللي اتغيّر فعلًا؟ واختار الحساب اللي بيمثله.", "remediationLessonId": "L01" },
    { "tag": "missing-line", "labelAr": "سطر ناقص في القيد", "explanationAr": "كل حساب اتغيّر لازم يظهر في القيد. راجع خطوة إيه اللي اتغيّر.", "remediationLessonId": "L02" },
    { "tag": "cogs-omitted", "labelAr": "نسيان قيد تكلفة البضاعة المباعة", "explanationAr": "في الجرد المستمر كل بيعة ليها قيدين: الإيراد بسعر البيع، والتكلفة بتكلفة الشراء.", "remediationLessonId": "L05" },
    { "tag": "wrong-amount", "labelAr": "مبلغ غير صحيح", "explanationAr": "راجع المستند: الكمية × السعر، وهل المطلوب سعر البيع ولا التكلفة.", "remediationLessonId": "L02" },
    { "tag": "unbalanced-entry", "labelAr": "قيد غير متوازن", "explanationAr": "مجموع المدين لازم يساوي مجموع الدائن بالظبط.", "remediationLessonId": "L03" },
    { "tag": "wrong-party", "labelAr": "طرف (عميل/مورد) غلط", "explanationAr": "الحساب الإجمالي ممكن يبقى صح والرصيد الفرعي للعميل أو المورد يبقى غلط — راجع الفاتورة وإيصال التخصيص.", "remediationLessonId": "L06" },
    { "tag": "entry-missed", "labelAr": "حدث محتاج قيد واتساب", "explanationAr": "لو الحدث غيّر مورد أو التزام أو حق ملكية — لازم يتسجل.", "remediationLessonId": "L02" },
